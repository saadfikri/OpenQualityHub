# ============================================================
# Open Quality Hub - Environment Configuration
# ============================================================
# Copy this file to .env and adjust values for your environment.
# Default values work for local development with Docker Compose.

# ---- Database ----
DATABASE_URL=jdbc:postgresql://localhost:5432/openqualityhub
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DB_POOL_MAX=10
DB_POOL_MIN=2

# ---- JWT (generate a strong base64-encoded key for production) ----
JWT_SECRET=Y29tcGxleC1zZWNyZXQta2V5LWZvci1vcGVuLXF1YWxpdHktaHViLWp3dC10b2tlbi1zaWduaW5nLWRldi1vbmx5
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---- Server ----
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Rate Limiting ----
RATE_LIMIT_AUTH_RPM=20

# ---- Spring Profile (demo loads sample data) ----
SPRING_PROFILE=demo

# ---- Logging ----
LOG_LEVEL=DEBUG
